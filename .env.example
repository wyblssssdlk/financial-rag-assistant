# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# 阿里云百炼 / DashScope API Key（必填）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 向量模型与回答模型
EMBEDDING_MODEL=text-embedding-v2
LLM_MODEL=qwen-flash

# 提示词中引用的财报名称（更换财报时修改）
REPORT_TITLE=厦门灿坤实业股份有限公司2019年年度报告

# 可选：Windows 下项目路径含中文时，向量库存放的纯英文目录
# CHENGMING_DATA_DIR=D:/ChengmingData

# 可选：DashScope 请求走系统代理（默认直连）
# DASHSCOPE_USE_SYSTEM_PROXY=1
